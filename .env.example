# Tanda — variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. Nombre y propósito viven aquí y en
# docs/operacion/SECRETOS-Y-VARIABLES.md; **los valores nunca se commitean**.
#
# Ninguna credencial de servicio externo hace falta para levantar el entorno local: con
# ENTORNO=local, WhatsApp, la pasarela y los mapas usan implementaciones de desarrollo.

# ── Aplicación ───────────────────────────────────────────────────────────────
# local | staging | produccion. Decide qué implementación de cada proveedor externo se usa.
ENTORNO=local
# Firma de los tokens de acceso. Rotarla cierra todas las sesiones abiertas.
SECRET_KEY=cambiame-en-local-por-cualquier-cadena-larga
# Verbosidad de los registros. Los registros no llevan teléfonos, correos ni datos de tarjeta.
NIVEL_LOG=info
# Base de las URL absolutas: sitemap, enlaces de notificaciones y enlaces profundos.
URL_PUBLICA_WEB=http://localhost:3100
# Orígenes que pueden llamar a la API desde un navegador, separados por comas. Explícitos y
# nunca un comodín: con credenciales, un asterisco regala las sesiones. Ojo, para el navegador
# localhost y 127.0.0.1 son orígenes distintos, y hacen falta los dos en local.
ORIGENES_PERMITIDOS=http://localhost:3000,http://localhost:3100,http://localhost:3200,http://localhost:3300,http://localhost:3400,http://127.0.0.1:3000,http://127.0.0.1:3100,http://127.0.0.1:3200,http://127.0.0.1:3300,http://127.0.0.1:3400
# Zona IANA que se propone al dar de alta un negocio. Panamá no tiene horario de verano.
ZONA_HORARIA_DEFECTO=America/Panama
# Código de moneda de los importes, que se guardan en centavos. El símbolo que se pinta es "$".
MONEDA_DEFECTO=USD

# ── Base de datos y caché ────────────────────────────────────────────────────
# PostgreSQL 16 con PostGIS. Este usuario NO es dueño de las tablas y NO tiene BYPASSRLS:
# el aislamiento entre negocios depende de ello.
DATABASE_URL=postgresql+asyncpg://agenda_api:agenda@localhost:5433/agenda
# Conexión con el rol dueño. La usa SOLO Alembic, para migrar y crear extensiones.
DATABASE_URL_MIGRACIONES=postgresql+psycopg://agenda_owner:agenda@localhost:5433/agenda
# Rol de SOLO LECTURA del marketplace. Es otra conexión y no un cambio de rol sobre la misma:
# con una sola, un olvido dejaría una consulta pública corriendo con permisos de negocio.
DATABASE_URL_PUBLICO=postgresql+asyncpg://agenda_publico:agenda@localhost:5433/agenda
# Rol de la CONSOLA INTERNA de M2G (back-office). Tercera conexión por el mismo motivo que la
# pública: si un endpoint del panel compartiera conexión con la consola, un fallo de
# autorización allí tendría los permisos del equipo interno.
DATABASE_URL_ADMIN=postgresql+asyncpg://agenda_admin:agenda@localhost:5433/agenda
# Caché de horarios y transporte de los trabajos en segundo plano.
REDIS_URL=redis://localhost:6379/0
# Conexión de los trabajos en segundo plano. Usa el rol auditado agenda_admin porque el
# planificador necesita ENUMERAR negocios antes de saber en cuál trabajar, y con el rol de la
# API y sin tenant fijado la seguridad por fila devuelve cero filas. El trabajo concreto sí se
# ejecuta después con el negocio fijado.
DATABASE_URL_TRABAJOS=postgresql+asyncpg://agenda_admin:agenda@localhost:5433/agenda

# ── WhatsApp, SMS, correo y push ─────────────────────────────────────────────
# Token de Meta WhatsApp Cloud API: canal principal del OTP y de las notificaciones.
# Pendiente: aún no existe. En local no hace falta.
WHATSAPP_TOKEN=
# Identificador del número emisor en Meta.
WHATSAPP_PHONE_ID=
# Cadena de verificación del webhook de estados de entrega de Meta.
WHATSAPP_WEBHOOK_TOKEN=
# Proveedor de SMS. Solo respaldo del OTP; vigilar el coste por mensaje.
SMS_API_KEY=
# Correo transaccional: respaldo de notificaciones e invitaciones de equipo.
# EMAIL_API_KEY — retirada: el correo va por SMTP (ADR-0024). Ver el bloque SMTP_ de abajo.
# Credenciales de FCM y APNs para las notificaciones de la app. Fase 5.
PUSH_CREDENCIALES=

# ── Consola interna (back-office) ────────────────────────────────────────────
# Cuánto dura el acceso de la consola, en minutos. Más corto que el de un cliente a propósito:
# quien entra aquí ve los datos de todos los negocios.
ACCESO_ADMIN_MINUTOS=30
# Cuánto dura su refresco, en horas.
REFRESCO_ADMIN_HORAS=8
# Cuenta inicial de la consola. La crea `python -m agenda.consola_alta`, que además imprime
# UNA SOLA VEZ el secreto del segundo factor para meterlo en el autenticador. Si se dejan
# vacías, el comando genera una contraseña al azar y la enseña por pantalla.
CONSOLA_EMAIL_INICIAL=
CONSOLA_PASSWORD_INICIAL=

# La contraseña que comparten TODAS las cuentas de ejemplo que crea `python -m agenda.semilla`
# (clientas, dueños y profesionales). No es un secreto: la semilla se niega a correr fuera de
# local y esas cuentas se borran y se rehacen en cada carga. Se deja aquí para poder cambiarla
# en una máquina sin tocar el código. Vacía, vale la de por defecto.
SEMILLA_CONTRASENA=

# ── Valores por defecto de negocio ───────────────────────────────────────────
# El brief los deja configurables y cada salón guarda los suyos; esto es solo la semilla con la
# que nace uno nuevo. Se cambian desde el back-office sin desplegar, así que tocarlos aquí solo
# afecta a los salones que se creen después.
# Cada cuántos minutos empieza un hueco.
GRANULARIDAD_MINUTOS=15
# Con cuánta antelación mínima se puede reservar, en horas.
ANTELACION_MINIMA_HORAS=1
# Hasta cuántos días en adelante se abre la agenda.
ANTELACION_MAXIMA_DIAS=60
# Hasta cuántas horas antes puede cancelar la clienta por su cuenta.
VENTANA_CANCELACION_HORAS=2
# Cuántos días tiene para opinar después de la cita.
VENTANA_REVIEW_DIAS=14

# ── Mapas y almacenamiento ───────────────────────────────────────────────────
# Base de las URL de las fotos de negocios y reseñas. Vacía = la clave guardada ya es servible
# (`/fotos/spa.webp`) o una URL absoluta. Cuando entre el almacenamiento de objetos se rellena
# aquí y no hay que tocar ni una fila ni una pantalla. En local apunta al MinIO del compose.
URL_BASE_MEDIA=http://localhost:9000/m2g-agenda-media-dev
# Token del proveedor de mapas y geocoding. Mapbox por defecto, pendiente de confirmar por coste.
MAPAS_TOKEN=
# ── El almacén de fotos, compatible con S3 (ADR-0023) ────────────────────────
# En local lo levanta el propio docker-compose (MinIO), así que esto funciona en una máquina
# recién clonada sin credencial de nadie. Para un entorno publicado se contrata un espacio
# —Hetzner Object Storage, Cloudflare R2, Backblaze B2 o Amazon— y se cambian estos valores.
#
# **Son dos direcciones y no una**, y es la trampa de este bloque: `S3_ENDPOINT` la usa la API
# desde dentro de la red de Docker y `S3_ENDPOINT_PUBLICO` la usa el **navegador**, que sube
# directo. `almacen:9000` no existe fuera de Docker y `localhost:9000` no existe dentro; con
# una sola, o no firma la API o no sube el navegador. En un entorno publicado las dos son la
# misma, la del proveedor.
S3_ENDPOINT=http://almacen:9000
S3_ENDPOINT_PUBLICO=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=m2g-agenda-media-dev
# Las de abajo abren un almacén que vive en el portátil: no son un secreto y no lo pretenden.
# En un entorno publicado se generan en la consola del proveedor y **la secreta se enseña una
# sola vez**; van a Bitwarden en la entrada «Bukeo · Almacenamiento de fotos».
S3_ACCESS_KEY_ID=agenda-local
S3_SECRET_ACCESS_KEY=agenda-local-secreta
# Cuánto vale un permiso de subida. Cinco minutos: lo que tarda alguien en elegir una foto con
# una conexión mala, y poco para que un permiso filtrado sirva de algo.
S3_PERMISO_MINUTOS=5
# El tope de una foto: cinco megas, una de móvil sin recortar. El límite viaja **dentro de la
# firma**, así que lo impone el almacén y no la buena voluntad de quien sube.
S3_TAMANO_MAXIMO_BYTES=5242880

# ── El correo transaccional, por SMTP (ADR-0024) ─────────────────────────────
# **SMTP y no la API de un proveedor**, por lo mismo que el almacén habla S3: lo hablan todos
# —Resend, SendGrid, Postmark, Amazon SES, Mailgun—, así que cambiar de proveedor es cambiar
# estas variables y no una línea de código.
#
# En local apunta al buzón del docker-compose, que se lee en http://localhost:8025 y **no le
# manda nada a nadie**.
SMTP_HOST=correo
SMTP_PUERTO=1025
SMTP_USUARIO=
SMTP_CONTRASENA=
# El remitente. En un entorno publicado tiene que ser una dirección del dominio verificado, con
# SPF y DKIM puestos, o el correo acaba en la carpeta de basura de todo el mundo.
SMTP_DESDE=Tanda <hola@localhost>
# STARTTLS. Falso solo en local, donde el buzón de desarrollo no cifra. **Verdadero en
# cualquier otro sitio**: sin esto el usuario y la contraseña viajan en claro.
SMTP_TLS=false

# ── Cuánto se guarda cada cosa (Ley 81 · ADR-0025) ───────────────────────────
# El rastro de las acciones internas: quién entró en qué negocio, quién forzó una cancelación,
# quién suplantó a quién. Doce meses cubre una reclamación —que llega en semanas, no en años—
# sin volverse un archivo histórico de la vida privada de nadie. Un trabajo diario lo barre.
RETENCION_AUDITORIA_MESES=12
# **Este plazo no lo decide el producto: lo dice la DGI, y hay que confirmarlo con la asesoría.**
# Está aquí para que el día que se confirme haya un solo sitio donde ponerlo. Mientras tanto
# **nada borra una factura**: se prefiere guardar de más a tener un problema con Hacienda.
RETENCION_FACTURAS_ANOS=5

# ── Pagos ────────────────────────────────────────────────────────────────────
# Credencial de la pasarela. La pasarela concreta está sin decidir; la elige Luis.
# Solo se guarda el token del método de pago: datos de tarjeta, nunca.
PASARELA_API_KEY=
# Verificación de los webhooks de cobro.
PASARELA_WEBHOOK_SECRET=

# ── Observabilidad ───────────────────────────────────────────────────────────
# Errores de API, worker y web. Vacío en local.
SENTRY_DSN=
# Buzón del proveedor de mensajes de desarrollo: aquí se escriben los OTP y los recordatorios
# mientras no haya canal real, para poder leerlos sin credenciales de Meta.
AGENDA_BUZON_NOTIFICACIONES=./buzon-notificaciones.jsonl

# ── Marca ────────────────────────────────────────────────────────────────────
# Nombre comercial. **Decidido el 7 de septiembre de 2026: Tanda** (dirección C de la revisión
# 5). Sigue siendo una variable y no una constante: cambiarlo aquí lo cambia en toda la web
# —cabecera, pie, textos legales y títulos del navegador— sin tocar ni un componente.
NOMBRE_COMERCIAL=Tanda
